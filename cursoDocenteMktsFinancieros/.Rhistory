lockedChunks=TRUE
conn=dbConnect(RSQLite::SQLite(), "maizBlanco.db")
# Load the workspace file with the input data:
load("savedWorkspaces/part3CointegrationPortfoliotests.RData")
# Filter the input data with the Mexican corn and futures data:
datatable(futuresDataFR)
# Calculate the tracking error of each future with the Mexican corn spot price:
trackingError <- function(rMX, rF) {
TE <- rMX - rF
return(TE)
}
# Calculate the tracking error of each future with the Mexican corn spot price:
trackingErrorData <- data.frame(Date = futuresDataFR$Date)
for (i in 3:(ncol(futuresDataFR))) {
trackingErrorData[, i-1] <- trackingError(futuresDataFR$nonCommodityPrice/100, futuresDataFR[, i])
}
# Set the column names of the tracking error data frame:
colnames(trackingErrorData) <- c("Date", colnames(futuresDataFR)[3:(ncol(futuresDataFR))])
portfolioScenariosNum=getCombinationsNumber(1:length(futureNames))
portfolioScenariosNames=getCombinations(futureNames)
nAssets=rep(2,length(portfolioScenariosNum))
for (a in 1:length(nAssets)){
nAssets[a]=eval(parse(text=paste0("length(",portfolioScenariosNum[a],")") ))
}
endRow=which.max(trackingErrorData$Date==as.Date("2000-01-02"))
datesSims=trackingErrorData$Date[endRow:nrow(trackingErrorData)]
# Inserts the portfolio scenarios in the conn data base object:
portfolioScenarios=data.frame(portfolioName=portfolioScenariosNames,
portfolio=portfolioScenariosNum
)
portfolioScenarios$startDate="2000-01-01"
portfolioScenarios$endDate=""
# Last observed values in the analysis:
portfolioScenarios$meanHedgingEffectiveness=NA
portfolioScenarios$meanHedgingEffectivenessOLS=NA
portfolioScenarios$lastHedgeRatio=NA
portfolioScenarios$meanHedgeRatio=NA
portfolioScenarios$HedgeRatioSD=NA
portfolioScenarios$lastHedgeRatioPValue=NA
portfolioScenarios$meanHedgeRatioPValue=NA
portfolioScenarios$HedgeRatioSDPValue=NA
portfolioScenarios$lastRMSE=NA
portfolioScenarios$lastAIC=NA
portfolioScenarios$hedgedPositionB100=NA
portfolioScenarios$olsHedgedPositionB100=NA
portfolioScenarios$fullHedgingEffectiveness=NA
portfolioScenarios$fullHedgingEffectivenessOLS=NA
portfolioScenarios$meanAIC=NA
portfolioScenarios$AICSD=NA
portfolioScenarios$meanRMSE=NA
portfolioScenarios$RMSESD=NA
# Inserts the portfolio scenarios in the conn data base object:
dbWriteTable(conn, "portfolioScenarios", portfolioScenarios,  overwrite = TRUE)
portSimReturnsF=data.frame(
Date=as.character(futuresDataFR$Date[endRow:nrow(futuresDataFR)]),
nonCommodityReturns=futuresDataFR$nonCommodityPrice[endRow:nrow(futuresDataFR)],
simulatedportfolioFuturesNames="nonCommodity",
nAssets=2,
simulatedPortfolioRet=futuresDataFR$nonCommodityPrice[endRow:nrow(futuresDataFR)],
simulatedPortfolioB100=futuresDataFR$nonCommodityPrice[endRow:nrow(futuresDataFR)],
simulatedHedgedPositionRet=futuresDataFR$nonCommodityPrice[endRow:nrow(futuresDataFR)],
simulatedHedgedPositionB100=futuresDataFR$nonCommodityPrice[endRow:nrow(futuresDataFR)],
simulatedOLSHedgedPositionRet=futuresDataFR$nonCommodityPrice[endRow:nrow(futuresDataFR)],
simulatedOLSHedgedPositionB100=futuresDataFR$nonCommodityPrice[endRow:nrow(futuresDataFR)],
RMSE=NA,
AIC=NA,
hedgingEffectiveness=0,
hedgingEffectivenessOLS=0,
hedgeRatio=1,
hedgeRatioPValue=0,
nonHeddgingDate=FALSE
)
portSimReturnsF$simulatedPortfolioB100=(portSimReturnsF$simulatedPortfolioB100/100)+1
portSimReturnsF$simulatedPortfolioB100[1]=futuresDataF[endRow+1,2]
portSimReturnsF$simulatedPortfolioB100=cumprod(portSimReturnsF$simulatedPortfolioB100)
# Inserts the portfolio scenarios in the conn data base object:
dbWriteTable(conn, "simulationDataTrackingError1", portSimReturnsF,  overwrite = TRUE)
warntT=TRUE
portfolioScenarios=dbGetQuery(conn, "SELECT * FROM portfolioScenarios")
# Detects the pending scenarios to test and record in the data base (just in case the computer crashed due to memory issues in the simulations):
pendingScenarios=which(portfolioScenarios$endDate=="")
# Checks if there are pending scenarios to run:
if (length(pendingScenarios)>0){
# Filters the pending scenarios to evaluate:
portfolioScenarios=portfolioScenarios[pendingScenarios,]
# a portfolios or scenarios:----------------------------------------
# Runs the simulations for the pending scenarios to evaluate:
for (a in 1:nrow(portfolioScenarios)){
# Determines if there is data in the conn data base for the current portfolio scenario:
if (str_equal(portfolioScenarios$endDate[a],"")){
eval(parse(text=paste0("futureColID=",portfolioScenarios$portfolio[a])))
# Creates the porfolio simulation (returns) data.frame:
portSimReturns=data.frame(
Date=as.character(futuresDataFR$Date[endRow:nrow(futuresDataFR)]),
nonCommodityReturns=futuresDataFR$nonCommodityPrice[endRow:nrow(futuresDataFR)],
simulatedportfolioFuturesNames=portfolioScenariosNames[a],
nAssets=nAssets[a],
simulatedPortfolioRet=NA,
simulatedPortfolioB100=NA,
simulatedHedgedPositionRet=NA,
simulatedHedgedPositionB100=NA,
simulatedOLSHedgedPositionRet=NA,
simulatedOLSHedgedPositionB100=NA,
RMSE=NA,
AIC=NA,
hedgingEffectiveness=NA,
hedgingEffectivenessOLS=NA,
hedgeRatio=NA,
hedgeRatioPValue=NA,
nonHeddgingDate=FALSE
)
# Portfolio weights:
portSimWeights=matrix(0,nrow(futuresDataFR)-endRow+1,length(futureNames))
colnames(portSimWeights)=futureNames
portSimWeights=cbind(data.frame(
Date=as.character(futuresDataFR$Date[endRow:nrow(futuresDataFR)]),
simulatedportfolioFuturesNames=portfolioScenariosNames[a]),
as.data.frame(portSimWeights))
# t periods simulation:==========
# Simulates the portfolio hedging strategy a:
for (t in 1:nrow(portSimReturns)){
if (isTRUE(warntT)){
cat("\f")
print(paste0("Processing date ",t," of ",nrow(portSimReturns)," of portfolio ",
a," of ",nrow(portfolioScenarios)))
}
#retII=which(futureNames==portfolioScenarios[a])
inputReturns=trackingErrorData[1:(endRow+t-2),c(1,futureColID+1)]
#===== portfolio returns  analysis:
portAnalysis=minVariancePortfolio(inputReturns,shortsRestriction=TRUE)
# Backtest of the simulates portfolio and the Mexican corn spot price:
if (isTRUE(portAnalysis$continueTest)){
# Regression for hedging effectivenees test and RMSE input Data:
regressionData=data.frame(
nonCommodityPrice=futuresDataFR[1:(endRow+t-2),2],
simulatedPortfolio=rowSums(portAnalysis$weights*futuresDataFR[1:(endRow+t-2),futureColID+1])
)
# Records the last return of the simulated portfolio:
portSimReturns$simulatedPortfolioRet[t]=sum(portAnalysis$weights*futuresDataFR[(endRow+t-1),futureColID+1])
portSimReturns$simulatedPortfolioB100[t]=sum(portAnalysis$weights*futuresDataFR[(endRow+t-1),futureColID+1])
# Hedging Effectiveness at t record:
portSimReturns$hedgingEffectiveness[t]=1-(var(regressionData$nonCommodityPrice-regressionData$simulatedPortfolio)/var(regressionData$nonCommodityPrice))
# Regression:
regEq="nonCommodityPrice~simulatedPortfolio"
regTS1=lm(regEq,data=regressionData)
regTS <- coeftest(regTS1, vcov = NeweyWest(regTS1))
# OLS Hedging Effectiveness record:
portSimReturns$hedgingEffectivenessOLS[t]=1-(var(regressionData$nonCommodityPrice-(regTS[2,1]*regressionData$simulatedPortfolio))/var(regressionData$nonCommodityPrice))
portSimReturns$hedgeRatio[t]=regTS[2,1]
portSimReturns$hedgeRatioPValue[t]=regTS[2,4]
# Records the hedge position returns:
portSimReturns$simulatedHedgedPositionRet[t]=futuresDataFR[(endRow+t-1),2]-sum(portAnalysis$weights*futuresDataFR[(endRow+t-1),futureColID+1])
portSimReturns$simulatedHedgedPositionB100[t]=futuresDataFR[(endRow+t-1),2]-sum(portAnalysis$weights*futuresDataFR[(endRow+t-1),futureColID+1])
portSimReturns$simulatedOLSHedgedPositionRet[t]=futuresDataFR[(endRow+t-1),2]-(regTS[2,1]*sum(portAnalysis$weights*futuresDataFR[(endRow+t-1),futureColID+1]))
portSimReturns$simulatedOLSHedgedPositionB100[t]=futuresDataFR[(endRow+t-1),2]-(regTS[2,1]*sum(portAnalysis$weights*futuresDataFR[(endRow+t-1),futureColID+1]))
# RMSE and AIC:
portSimReturns$RMSE[t]=sqrt(mean((regressionData$nonCommodityPrice-regressionData$simulatedPortfolio)^2))
portSimReturns$AIC[t]=AIC(regTS1)
#===== portfolio historical weights:
for (b in 1:length(futureColID)){
portSimWeights[t,futureColID[b]+2]=portAnalysis$weights[b]*100
}
# If isTRUE(continueTest) ends here:
} else {
# The portfolio scenario is not feasible in the estimation, so it is not recorded:
portSimReturns$nonHeddgingDate=TRUE
}
# For t ends here:
}
# Estimates the 100 base values:
portSimReturns$simulatedPortfolioB100=portSimReturns$simulatedPortfolioB100/100+1
portSimReturns$simulatedPortfolioB100[1]=futuresDataF[endRow+1,2]
portSimReturns$simulatedPortfolioB100=cumprod(portSimReturns$simulatedPortfolioB100)
portSimReturns$simulatedHedgedPositionB100=portSimReturns$simulatedHedgedPositionB100/100+1
portSimReturns$simulatedHedgedPositionB100[1]=futuresDataF[endRow+1,2]
portSimReturns$simulatedHedgedPositionB100=cumprod(portSimReturns$simulatedHedgedPositionB100)
portSimReturns$simulatedOLSHedgedPositionB100=portSimReturns$simulatedOLSHedgedPositionB100/100+1
portSimReturns$simulatedOLSHedgedPositionB100[1]=futuresDataF[endRow+1,2]
portSimReturns$simulatedOLSHedgedPositionB100=cumprod(portSimReturns$simulatedOLSHedgedPositionB100)
# Stores the new data in the data base:--------------------------------------------------
# Inserts the portfolio scenarios in the conn data base object:
dbWriteTable(conn, "simulationDataTrackingError1", portSimReturns,  append = TRUE)
# Inserts the portfolio weights in the conn data base object:
dbWriteTable(conn, "simulationDataTrackingError1Weights", portSimWeights,  append = TRUE)
# Updates portfolioScenarios table in data base:-----------------------------------------
# Updates the record of endDate in the portfolioScenarios table of the SQLite data base:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET endDate='",as.character(tail(portSimReturns$Date,1)),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Estimates the summary of the performance measures in the simulations:
# Last hedging effectiveness:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET meanHedgingEffectiveness='",
mean(portSimReturns$hedgingEffectiveness),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Last hedging effectiveness OLS:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET meanHedgingEffectivenessOLS='",
mean(portSimReturns$hedgingEffectivenessOLS),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Last hedge ratio:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET lastHedgeRatio='",
tail(portSimReturns$hedgeRatio,1),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Mean hedge ratio:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET meanHedgeRatio='",
mean(portSimReturns$hedgeRatio,na.rm=TRUE),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Hedge ratio standard deviation:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET HedgeRatioSD='",
sd(portSimReturns$hedgeRatio,na.rm=TRUE),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Last hedge ratio p-value:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET lastHedgeRatioPValue='",
tail(portSimReturns$hedgeRatioPValue,1)*100,"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Mean hedge ratio p-value:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET meanHedgeRatioPValue='",
mean(portSimReturns$hedgeRatioPValue,na.rm=TRUE)*100,"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Hedge ratio standard deviation p-value:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET HedgeRatioSDPValue='",
sd(portSimReturns$hedgeRatioPValue,na.rm=TRUE)*100,"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Last RMSE:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET lastRMSE='",
tail(portSimReturns$RMSE,1),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Mean RMSE:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET meanRMSE='",
mean(portSimReturns$RMSE,na.rm=TRUE),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# RMSE standard deviation:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET RMSESD='",
sd(portSimReturns$RMSE,na.rm=TRUE),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Last AIC:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET lastAIC='",
tail(portSimReturns$AIC,1),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Mean AIC:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET meanAIC='",
mean(portSimReturns$AIC,na.rm=TRUE),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# AIC standard deviation:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET AICSD='",
sd(portSimReturns$AIC,na.rm=TRUE),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Hedged position B100:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET hedgedPositionB100='",
tail(portSimReturns$simulatedHedgedPositionB100,1),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# OLS hedged position B100:
dbExecute(conn, paste0("UPDATE portfolioScenarios SET olsHedgedPositionB100='",
tail(portSimReturns$simulatedOLSHedgedPositionB100,1),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Full hedging effectiveness:
fullHEregressionData=data.frame(
nonCommodityPrice=futuresDataFR[endRow:nrow(futuresDataFR),2],
simulatedPortfolio=portSimReturns$simulatedHedgedPositionRet
)
dbExecute(conn, paste0("UPDATE portfolioScenarios SET fullHedgingEffectiveness='",
1-(var(fullHEregressionData$simulatedPortfolio)/var(fullHEregressionData$nonCommodityPrice)),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Full hedging effectiveness OLS:
fullHEregressionData=data.frame(
nonCommodityPrice=futuresDataFR[endRow:nrow(futuresDataFR),2],
simulatedPortfolio=portSimReturns$simulatedOLSHedgedPositionRet
)
dbExecute(conn, paste0("UPDATE portfolioScenarios SET fullHedgingEffectivenessOLS='",
1-(var(fullHEregressionData$simulatedPortfolio)/var(fullHEregressionData$nonCommodityPrice)),"' WHERE portfolioName='",portfolioScenarios$portfolioName[a],"'"))
# Reports if there are new data stored in the data base or not:
if (isTRUE(warntT)){
cat("\f")
print(paste0("Portfolio ",a," of ",nrow(portfolioScenarios)," processed..."))
}
# If is.na for the a portfolio scenario ends here:
} else {
if (isTRUE(warntT)){
cat("\f")
print(paste0("Portfolio ",a," of ",nrow(portfolioScenarios)," has data stored in the data base..."))
}
}
# For a ends here:
}
# If pending scenarios ends here:
}
